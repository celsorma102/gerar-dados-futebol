    "conn = sqlite3.connect('taticatotal.db')\n",
    "cursor = conn.cursor()\n",
    "# Criação das tabelas\n",
    "cursor.execute('''\n",
    "    CREATE TABLE IF NOT EXISTS usuarios (\n",
    "        id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "        nome TEXT NOT NULL,\n",
    "        email TEXT NOT NULL UNIQUE,\n",
    "        senha TEXT NOT NULL\n",
    "    )\n",
    "''')\n",
    "# Tabela de jogadores, com um campo time_id para associar cada jogador a um time (pode ser 0 para jogadores sem time)\n",
    "cursor.execute('''\n",
    "    CREATE TABLE IF NOT EXISTS jogadores (\n",
    "        id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "        nome TEXT NOT NULL,\n",
    "        posicao TEXT NOT NULL,\n",
    "        idade INTEGER NOT NULL,\n",
    "        overall INTEGER NOT NULL,\n",
    "        nacionalidade TEXT NOT NULL,\n",
    "        time_id INTEGER NOT NULL DEFAULT 0,\n",
    "        FOREIGN KEY (time_id) REFERENCES times(id)\n",
    "    )\n",
    "''')\n",
    "# Tabela de times, com campos para nome, liga e estádio (liga_id e estadio_id são chaves estrangeiras)\n",
    "cursor.execute('''\n",
    "    CREATE TABLE IF NOT EXISTS times (\n",
    "        id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "        nome TEXT NOT NULL,\n",
    "        liga_id INTEGER,\n",
    "        estadio_id INTEGER,\n",
    "        FOREIGN KEY (liga_id) REFERENCES ligas(id),\n",
    "        FOREIGN KEY (estadio_id) REFERENCES estadios(id)\n",
    "    )\n",
    "''')\n",
    "# Tabelas para ligas e estádios, para permitir a associação de times a ligas e estádios específicos\n",
    "cursor.execute('''\n",
    "    CREATE TABLE IF NOT EXISTS estadios (\n",
    "        id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "        nome TEXT NOT NULL,\n",
    "        capacidade INTEGER NOT NULL,\n",
    "        tipo TEXT NOT NULL\n",
    "    )''')\n",
    "# Tabela de ligas, para permitir a associação de times a ligas específicas\n",
    "cursor.execute('''\n",
    "    CREATE TABLE IF NOT EXISTS ligas (\n",
    "        id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "        nome TEXT NOT NULL\n",
    "    )''')\n",
    "\n",
    "conn.commit()\n",
    "conn.close()"
   ]
